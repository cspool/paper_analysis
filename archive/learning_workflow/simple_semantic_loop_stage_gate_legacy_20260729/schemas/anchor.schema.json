{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simple-semantic-loop:anchor:v1",
  "title": "ANCHOR",
  "type": "object",
  "properties": {
    "anchorId": {
      "type": "string",
      "minLength": 1
    },
    "topicId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "scenario": {
      "type": "object",
      "properties": {
        "workload": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "regime": {
          "type": "string",
          "minLength": 1
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "workload",
        "phase",
        "regime",
        "stack"
      ],
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "executionPath": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "configuration": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "comparisonScope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "name",
        "executionPath",
        "configuration",
        "comparisonScope"
      ],
      "additionalProperties": false
    },
    "performanceTension": {
      "type": "object",
      "properties": {
        "symptom": {
          "type": "string",
          "minLength": 1
        },
        "suspectedMechanism": {
          "type": "string",
          "minLength": 1
        },
        "bottleneckResources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "targetMetrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "symptom",
        "suspectedMechanism",
        "bottleneckResources",
        "targetMetrics"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openNeedIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "directionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "active",
        "saturated",
        "rejected"
      ]
    },
    "statusReason": {
      "type": "string"
    },
    "saturationReason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "anchorId",
    "topicId",
    "revision",
    "scenario",
    "baseline",
    "performanceTension",
    "constraints",
    "evidenceRefs",
    "openNeedIds",
    "directionIds",
    "status",
    "statusReason",
    "saturationReason"
  ],
  "additionalProperties": false
}
