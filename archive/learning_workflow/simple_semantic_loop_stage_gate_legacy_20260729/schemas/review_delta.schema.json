{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simple-semantic-loop:review_delta:v1",
  "title": "REVIEW_DELTA",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 1
    },
    "messageType": {
      "type": "string",
      "const": "REVIEW_DELTA"
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "stageId": {
      "type": "string",
      "minLength": 1
    },
    "stageContractHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stateBinding": {
      "type": "object",
      "properties": {
        "snapshotVersion": {
          "type": "integer",
          "minimum": 0
        },
        "canonicalRevision": {
          "type": "integer",
          "minimum": 0
        },
        "eventCursor": {
          "type": "integer",
          "minimum": 0
        },
        "workflowPlanRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "snapshotVersion",
        "canonicalRevision",
        "eventCursor",
        "workflowPlanRevision"
      ],
      "additionalProperties": false
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "string",
          "minLength": 1
        },
        "directionId": {
          "type": "string",
          "minLength": 1
        },
        "directionRevision": {
          "type": "integer",
          "minimum": 1
        },
        "supportedParts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceRefsUsed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weakestCausalLink": {
          "type": [
            "string",
            "null"
          ]
        },
        "baselineProblem": {
          "type": [
            "string",
            "null"
          ]
        },
        "implementationProblem": {
          "type": [
            "string",
            "null"
          ]
        },
        "measurementProblem": {
          "type": [
            "string",
            "null"
          ]
        },
        "strongestCounterexample": {
          "type": [
            "string",
            "null"
          ]
        },
        "counterexampleResolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextQuestion": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextQuestionAnswerableFromKnowledgeBase": {
          "type": "boolean"
        },
        "decision": {
          "type": "string",
          "enum": [
            "continue_search",
            "testable",
            "experiment_required",
            "rejected"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "duplicateOfDirectionRef": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "objectType": {
                  "type": "string",
                  "minLength": 1
                },
                "objectId": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "objectType",
                "objectId",
                "revision"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "duplicateComparison": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "baselineScopeEquivalent": {
                  "type": "boolean"
                },
                "primaryChangeEquivalent": {
                  "type": "boolean"
                },
                "causalTargetEquivalent": {
                  "type": "boolean"
                },
                "materialDifference": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "baselineScopeEquivalent",
                "primaryChangeEquivalent",
                "causalTargetEquivalent",
                "materialDifference"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "rejectionCategory": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "duplicate",
                "out_of_scope",
                "causal_contradiction",
                "unfair_comparison",
                "no_performance_mechanism",
                "invalid_evidence",
                "other"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "readinessChecks": {
          "type": "object",
          "properties": {
            "inTopicAndAnchorScope": {
              "type": "boolean"
            },
            "baselineFair": {
              "type": "boolean"
            },
            "minimumChangeSetExplicit": {
              "type": "boolean"
            },
            "causalChainFalsifiable": {
              "type": "boolean"
            },
            "implementationPathBounded": {
              "type": "boolean"
            },
            "measurementPlanComplete": {
              "type": "boolean"
            },
            "falsifiersPresent": {
              "type": "boolean"
            },
            "criticalCounterexampleResolved": {
              "type": "boolean"
            },
            "evidenceTraceable": {
              "type": "boolean"
            },
            "knowledgeAnswerableCriticalGapRemaining": {
              "type": "boolean"
            },
            "newExperimentRequired": {
              "type": "boolean"
            }
          },
          "required": [
            "inTopicAndAnchorScope",
            "baselineFair",
            "minimumChangeSetExplicit",
            "causalChainFalsifiable",
            "implementationPathBounded",
            "measurementPlanComplete",
            "falsifiersPresent",
            "criticalCounterexampleResolved",
            "evidenceTraceable",
            "knowledgeAnswerableCriticalGapRemaining",
            "newExperimentRequired"
          ],
          "additionalProperties": false
        },
        "experimentHandoff": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "handoffId": {
                  "type": "string",
                  "minLength": 1
                },
                "directionId": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "const": "EXPERIMENT_REQUIRED"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "requiredArtifact": {
                  "type": "string",
                  "enum": [
                    "trace",
                    "prototype",
                    "benchmark",
                    "equivalence_test",
                    "code_audit",
                    "hardware_measurement"
                  ]
                },
                "hypothesisToTest": {
                  "type": "string",
                  "minLength": 1
                },
                "suggestedEntryPoints": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "controlledVariables": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "metrics": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "acceptanceCriteria": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "failureStopConditions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "executionAuthorized": {
                  "type": "boolean",
                  "const": false
                }
              },
              "required": [
                "handoffId",
                "directionId",
                "tag",
                "reason",
                "requiredArtifact",
                "hypothesisToTest",
                "suggestedEntryPoints",
                "controlledVariables",
                "metrics",
                "acceptanceCriteria",
                "failureStopConditions",
                "executionAuthorized"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "reviewId",
        "directionId",
        "directionRevision",
        "supportedParts",
        "evidenceRefsUsed",
        "weakestCausalLink",
        "baselineProblem",
        "implementationProblem",
        "measurementProblem",
        "strongestCounterexample",
        "counterexampleResolution",
        "nextQuestion",
        "nextQuestionAnswerableFromKnowledgeBase",
        "decision",
        "rationale",
        "duplicateOfDirectionRef",
        "duplicateComparison",
        "rejectionCategory",
        "readinessChecks",
        "experimentHandoff"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "messageType",
    "workflowId",
    "runId",
    "taskId",
    "attemptId",
    "stageId",
    "stageContractHash",
    "stateBinding",
    "inputHash",
    "payload"
  ],
  "additionalProperties": false
}
