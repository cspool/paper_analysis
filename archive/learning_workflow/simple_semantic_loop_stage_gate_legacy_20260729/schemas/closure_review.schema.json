{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simple-semantic-loop:closure_review:v1",
  "title": "CLOSURE_REVIEW",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 1
    },
    "messageType": {
      "type": "string",
      "const": "CLOSURE_REVIEW"
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "stageId": {
      "type": "string",
      "minLength": 1
    },
    "stageContractHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stateBinding": {
      "type": "object",
      "properties": {
        "snapshotVersion": {
          "type": "integer",
          "minimum": 0
        },
        "canonicalRevision": {
          "type": "integer",
          "minimum": 0
        },
        "eventCursor": {
          "type": "integer",
          "minimum": 0
        },
        "workflowPlanRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "snapshotVersion",
        "canonicalRevision",
        "eventCursor",
        "workflowPlanRevision"
      ],
      "additionalProperties": false
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "string",
          "minLength": 1
        },
        "stopCandidateId": {
          "type": "string",
          "minLength": 1
        },
        "canonicalRevision": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "const": "complete"
        },
        "decision": {
          "type": "string",
          "enum": [
            "accept",
            "reject"
          ]
        },
        "verifiedClosureBasis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check": {
                "type": "string",
                "enum": [
                  "stopProofRevisionCurrent",
                  "stopProofMatchesCanonical",
                  "mechanicalPreflightPassed",
                  "topicScopePreserved",
                  "noKnowledgeAnswerableCriticalNeed",
                  "allAnchorsClosed",
                  "allDirectionsTerminal",
                  "lastTopicExpansionNoDelta",
                  "noUnconsumedOrUncommittedWork",
                  "criticalContradictionsReviewed",
                  "experimentHandoffsComplete",
                  "runtimeEligibleForCompletion",
                  "finalOutputTraceable"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "objectRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "objectType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "objectId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "revision": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    }
                  },
                  "required": [
                    "objectType",
                    "objectId",
                    "revision"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "check",
              "statement",
              "objectRefs"
            ],
            "additionalProperties": false
          }
        },
        "closureChecks": {
          "type": "object",
          "properties": {
            "stopProofRevisionCurrent": {
              "type": "boolean"
            },
            "stopProofMatchesCanonical": {
              "type": "boolean"
            },
            "mechanicalPreflightPassed": {
              "type": "boolean"
            },
            "topicScopePreserved": {
              "type": "boolean"
            },
            "noKnowledgeAnswerableCriticalNeed": {
              "type": "boolean"
            },
            "allAnchorsClosed": {
              "type": "boolean"
            },
            "allDirectionsTerminal": {
              "type": "boolean"
            },
            "lastTopicExpansionNoDelta": {
              "type": "boolean"
            },
            "noUnconsumedOrUncommittedWork": {
              "type": "boolean"
            },
            "criticalContradictionsReviewed": {
              "type": "boolean"
            },
            "experimentHandoffsComplete": {
              "type": "boolean"
            },
            "runtimeEligibleForCompletion": {
              "type": "boolean"
            },
            "finalOutputTraceable": {
              "type": "boolean"
            }
          },
          "required": [
            "stopProofRevisionCurrent",
            "stopProofMatchesCanonical",
            "mechanicalPreflightPassed",
            "topicScopePreserved",
            "noKnowledgeAnswerableCriticalNeed",
            "allAnchorsClosed",
            "allDirectionsTerminal",
            "lastTopicExpansionNoDelta",
            "noUnconsumedOrUncommittedWork",
            "criticalContradictionsReviewed",
            "experimentHandoffsComplete",
            "runtimeEligibleForCompletion",
            "finalOutputTraceable"
          ],
          "additionalProperties": false
        },
        "blockingFindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "findingId": {
                "type": "string",
                "minLength": 1
              },
              "check": {
                "type": "string",
                "enum": [
                  "stopProofRevisionCurrent",
                  "stopProofMatchesCanonical",
                  "mechanicalPreflightPassed",
                  "topicScopePreserved",
                  "noKnowledgeAnswerableCriticalNeed",
                  "allAnchorsClosed",
                  "allDirectionsTerminal",
                  "lastTopicExpansionNoDelta",
                  "noUnconsumedOrUncommittedWork",
                  "criticalContradictionsReviewed",
                  "experimentHandoffsComplete",
                  "runtimeEligibleForCompletion",
                  "finalOutputTraceable"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "knowledge_gap",
                  "state_inconsistency",
                  "incomplete_handoff",
                  "runtime_pause"
                ]
              },
              "code": {
                "type": "string",
                "enum": [
                  "stale_stop_proof_revision",
                  "stop_proof_canonical_mismatch",
                  "mechanical_preflight_failed",
                  "topic_scope_silently_narrowed",
                  "knowledge_answerable_open_need",
                  "anchor_not_closed",
                  "anchor_missing_saturation_reason",
                  "anchor_missing_status_reason",
                  "direction_nonterminal",
                  "direction_missing_terminal_reason",
                  "last_topic_expansion_missing",
                  "last_topic_expansion_not_quiet",
                  "pending_task",
                  "in_flight_task",
                  "pending_output_retry",
                  "unconsumed_result",
                  "uncommitted_delta",
                  "unresolved_validation_failure",
                  "failed_task",
                  "unreviewed_critical_contradiction",
                  "experiment_handoff_missing",
                  "experiment_handoff_invalid",
                  "runtime_budget_exhausted",
                  "runtime_failed_or_paused",
                  "final_output_missing_field",
                  "final_output_untraceable"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "objectRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "objectType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "objectId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "revision": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    }
                  },
                  "required": [
                    "objectType",
                    "objectId",
                    "revision"
                  ],
                  "additionalProperties": false
                }
              },
              "reopenScope": {
                "type": "object",
                "properties": {
                  "objectType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "objectId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  }
                },
                "required": [
                  "objectType",
                  "objectId",
                  "revision"
                ],
                "additionalProperties": false
              },
              "recoveryAction": {
                "type": "string",
                "enum": [
                  "REOPEN_FRONTIER",
                  "REPAIR_STATE",
                  "COMPLETE_HANDOFF",
                  "RESUME_RUNTIME"
                ]
              }
            },
            "required": [
              "findingId",
              "check",
              "type",
              "code",
              "summary",
              "objectRefs",
              "reopenScope",
              "recoveryAction"
            ],
            "additionalProperties": false
          }
        },
        "reopenScopes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "objectType": {
                "type": "string",
                "minLength": 1
              },
              "objectId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            },
            "required": [
              "objectType",
              "objectId",
              "revision"
            ],
            "additionalProperties": false
          }
        },
        "allowsFinalization": {
          "type": "boolean"
        },
        "finalizationRequirements": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "canonical_revision_unchanged",
              "full_validator_passed",
              "final_output_rendered",
              "final_output_coverage_validated",
              "atomic_completed_commit"
            ]
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reviewId",
        "stopCandidateId",
        "canonicalRevision",
        "status",
        "decision",
        "verifiedClosureBasis",
        "closureChecks",
        "blockingFindings",
        "reopenScopes",
        "allowsFinalization",
        "finalizationRequirements",
        "rationale"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "messageType",
    "workflowId",
    "runId",
    "taskId",
    "attemptId",
    "stageId",
    "stageContractHash",
    "stateBinding",
    "inputHash",
    "payload"
  ],
  "additionalProperties": false
}
