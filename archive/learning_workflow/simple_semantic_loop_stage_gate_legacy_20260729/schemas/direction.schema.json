{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simple-semantic-loop:direction:v1",
  "title": "DIRECTION",
  "type": "object",
  "properties": {
    "directionId": {
      "type": "string",
      "minLength": 1
    },
    "anchorId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "atomId": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string",
            "enum": [
              "L1",
              "L2",
              "L3",
              "L4",
              "L5",
              "L6"
            ]
          },
          "object": {
            "type": "string",
            "minLength": 1
          },
          "fromState": {
            "type": "string",
            "minLength": 1
          },
          "toState": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "enabler",
              "alternative",
              "constraint"
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "atomId",
          "layer",
          "object",
          "fromState",
          "toState",
          "role",
          "conditions",
          "evidenceRefs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "causalLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "causes",
              "enables",
              "controls",
              "requires",
              "conflicts"
            ]
          },
          "condition": {
            "type": "string"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "directness": {
            "type": "string",
            "enum": [
              "direct",
              "inferred",
              "unknown"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "relation",
          "condition",
          "evidenceRefs",
          "directness"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "comparison": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "controlledVariables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ablations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "baseline",
        "controlledVariables",
        "ablations"
      ],
      "additionalProperties": false
    },
    "expectedEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "expectedDirection": {
            "type": "string",
            "enum": [
              "increase",
              "decrease",
              "maintain"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "metric",
          "expectedDirection",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "implementation": {
      "type": "object",
      "properties": {
        "targetComponents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knownEntryPoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolvedInterfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "targetComponents",
        "knownEntryPoints",
        "unresolvedInterfaces"
      ],
      "additionalProperties": false
    },
    "falsifiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "degradationConditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supportingEvidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradictingEvidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inferredClaims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolvedNeedIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "seed",
        "exploring",
        "testable",
        "experiment_required",
        "rejected"
      ]
    },
    "statusReason": {
      "type": "string"
    },
    "experimentHandoffId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "directionId",
    "anchorId",
    "revision",
    "title",
    "hypothesis",
    "changes",
    "causalLinks",
    "comparison",
    "expectedEffects",
    "implementation",
    "falsifiers",
    "degradationConditions",
    "supportingEvidenceRefs",
    "contradictingEvidenceRefs",
    "inferredClaims",
    "unresolvedNeedIds",
    "status",
    "statusReason",
    "experimentHandoffId"
  ],
  "additionalProperties": false
}
