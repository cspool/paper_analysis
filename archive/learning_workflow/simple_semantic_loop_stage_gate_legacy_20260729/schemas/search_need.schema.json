{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simple-semantic-loop:search_need:v1",
  "title": "SEARCH_NEED",
  "type": "object",
  "properties": {
    "needId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "owner": {
      "type": "object",
      "properties": {
        "topicId": {
          "type": "string",
          "minLength": 1
        },
        "anchorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "directionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "topicId",
        "anchorId",
        "directionId"
      ],
      "additionalProperties": false
    },
    "intent": {
      "type": "string",
      "enum": [
        "discover_anchor",
        "define_baseline",
        "find_modification",
        "explain_mechanism",
        "find_implementation",
        "design_measurement",
        "challenge_direction",
        "verify_primary_source"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "successCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "primaryDimension": {
      "type": "string",
      "enum": [
        "idea",
        "knowledge",
        "experiment",
        "human",
        "paper"
      ]
    },
    "auxiliaryDimension": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "idea",
            "knowledge",
            "experiment",
            "human",
            "paper"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "targetDimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "idea",
          "knowledge",
          "experiment",
          "human",
          "paper"
        ]
      },
      "minItems": 1,
      "maxItems": 2
    },
    "queryVariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technicalObjects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "knownTerms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "synonymGroups": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      }
    },
    "scenarioTerms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "performanceRelations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceIntentTerms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excludedSourceUnits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "previousAttemptIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "critical": {
      "type": "boolean"
    },
    "answerability": {
      "type": "string",
      "enum": [
        "knowledge_base",
        "experiment_only",
        "unknown",
        "not_applicable"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "answered",
        "no_delta",
        "closed",
        "experiment_only"
      ]
    }
  },
  "required": [
    "needId",
    "revision",
    "owner",
    "intent",
    "question",
    "rationale",
    "successCriteria",
    "primaryDimension",
    "auxiliaryDimension",
    "targetDimensions",
    "queryVariants",
    "technicalObjects",
    "knownTerms",
    "synonymGroups",
    "scenarioTerms",
    "performanceRelations",
    "evidenceIntentTerms",
    "excludedSourceUnits",
    "previousAttemptIds",
    "critical",
    "answerability",
    "status"
  ],
  "additionalProperties": false
}
