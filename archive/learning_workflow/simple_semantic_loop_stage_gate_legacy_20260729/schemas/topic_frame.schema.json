{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simple-semantic-loop:topic_frame:v1",
  "title": "TOPIC_FRAME",
  "type": "object",
  "properties": {
    "topicId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "userTopic": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "workloads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regimes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stackScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layerScope": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "L1",
          "L2",
          "L3",
          "L4",
          "L5",
          "L6"
        ]
      }
    },
    "targetMetrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seedTerms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "synonymGroups": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      }
    },
    "unresolvedScopeQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scopeAudit": {
      "type": "object",
      "properties": {
        "initialFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "currentFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "changeId": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "changeType": {
                "type": "string",
                "enum": [
                  "narrow",
                  "broaden",
                  "clarify"
                ]
              },
              "userAuthorized": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "changeId",
              "field",
              "changeType",
              "userAuthorized",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "initialFingerprint",
        "currentFingerprint",
        "changes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "topicId",
    "revision",
    "userTopic",
    "objective",
    "workloads",
    "phases",
    "regimes",
    "stackScope",
    "layerScope",
    "targetMetrics",
    "invariants",
    "exclusions",
    "seedTerms",
    "synonymGroups",
    "unresolvedScopeQuestions",
    "scopeAudit"
  ],
  "additionalProperties": false
}
