![image.png](TCP%E6%8F%A1%E6%89%8B%E3%80%81%E6%8B%B7%E8%B4%9D%E3%80%81%E5%AE%9E%E7%8E%B0%E6%A0%88%E9%80%9F%E8%A7%88/image%2019.png)

