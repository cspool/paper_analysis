ame\":\"knowledge_notes/算法知识笔记/KV Cache Eviction (KV 缓存逐出).md\",\"basename\":\"KV Cache Eviction (KV 缓存逐出)\",\"score\":1084.9212380275737,\"foundWords\":[\"tree\",\"treekv\",\"based\",\"kv\",\"kvzip:\",\"kvzip\",\"kvs\",\"cache\",\"cache）且不减少显存占用（仅减少\",\"cache，不做任何\",\"cache，实现\",\"cache（浅层存储早期\"],\"matches\":[{\"match\":\"KV\",\"offset\":3},{\"match\":\"Cache\",\"offset\":6},{\"match\":\"KV\",\"offset\":22},{\"match\":\"KV\",\"offset\":62},{\"match\":\"Cache\",\"offset\":65},{\"match\":\"KV\",\"offset\":84},{\"match\":\"cache\",\"offset\":87},{\"match\":\"KV\",\"offset\":118},{\"match\":\"cache\",\"offset\":121},{\"match\":\"KV\",\"offset\":269},{\"match\":\"KV\",\"offset\":385},{\"match\":\"cache\",\"offset\":413},{\"match\":\"KVzip\",\"offset\":486},{\"match\":\"cache\",\"offset\":505},{\"match\":\"KV\",\"offset\":629},{\"match\":\"Cache\",\"offset\":632},{\"match\":\"cache\",\"offset\":752},{\"match\":\"cache\",\"offset\":765},{\"match\":\"cache\",\"offset\":977},{\"match\":\"cache\",\"offset\":987},{\"match\":\"cache\",\"offset\":1009},{\"match\":\"cache\",\"offset\":1019},{\"match\":\"cache\",\"offset\":1187},{\"match\":\"cache\",\"offset\":1237},{\"match\":\"cache\",\"offset\":1259},{\"match\":\"cache\",\"offset\":1282},{\"match\":\"KV\",\"offset\":1531},{\"match\":\"KV\",\"offset\":1611},{\"match\":\"KV\",\"offset\":1620},{\"match\":\"KVzip\",\"offset\":1669},{\"match\":\"KV\",\"offset\":1798},{\"match\":\"KV\",\"offset\":1843},{\"match\":\"KV\",\"offset\":1932},{\"match\":\"KV\",\"offset\":1941},{\"match\":\"KV\",\"offset\":2139},{\"match\":\"Cache\",\"offset\":2314},{\"match\":\"TreeKV\",\"offset\":2401},{\"match\":\"KV\",\"offset\":2494},{\"match\":\"KVzip\",\"offset\":3171},{\"match\":\"KV\",\"offset\":3310},{\"match\":\"KV\",\"offset\":3396},{\"match\":\"KVzip\",\"offset\":3416},{\"match\":\"KV\",\"offset\":3644},{\"match\":\"kv\",\"offset\":3674},{\"match\":\"KVzip\",\"offset\":3679},{\"match\":\"sK\",\"offset\":3859},{\"match\":\"。KVzi\",\"offset\":38