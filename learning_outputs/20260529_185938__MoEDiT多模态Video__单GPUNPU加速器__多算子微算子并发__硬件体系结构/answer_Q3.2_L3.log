 of Mixture-of-Experts Models in Production/MegaScale-MoE-Large-Scale-Communication-Efficient-Training-of-Mixture-of-Experts-Models-in-Production.md","basename":"MegaScale-MoE-Large-Scale-Communication-Efficient-Training-of-Mixture-of-Experts-Models-in-Production","score":737.2595588457646,"foundWords":["mega","megascale-moe-large-scale-communication-efficient-training-of-mixture-of-experts-models-in-production","megascale-moe,","megascale-moe:","megascale-moe","megascale","megatron-lm.","megatron-lm","megatron","kernel","kernels.","kernels"],"matches":[{"match":"MegaScale-MoE:","offset":2},{"match":"MegaScale-MoE,","offset":627},{"match":"MegaScale-MoE","offset":1149},{"match":"MegaScale-MoE","offset":1391},{"match":"MegaScale-MoE","offset":1595},{"match":"Megatron-LM.","offset":1705},{"match":"MegaScale-MoE:","offset":3239},{"match":"MegaScale-MoE,","offset":6734},{"match":"MegaScale-MoE","offset":6876},{"match":"MegaScale-MoE","offset":7170},{"match":"MegaScale-MoE","offset":7523},{"match":"MegaScale-MoE","offset":7620},{"match":"MegaScale-MoE","offset":8148},{"match":"MegaScale-MoE","offset":8231},{"match":"MegaScale-MoE","offset":8389},{"match":"MegaScale-MoE","offset":8653},{"match":"MegaScale-MoE","offset":8921},{"match":"MegaScale-MoE","offset":9111},{"match":"kernels.","offset":9291},{"match":"MegaScale-MoE","offset":9336},{"match":"kernel","offset":9402},{"match":"MegaScale-MoE","offset":9659},{"match":"MegaScale-MoE","offset":9814},{"match":"MegaScale-MoE","offset":9956},{"match":"MegaScale-MoE","offset":10163},{"match":"Megatron-LM","offset":10315},{"match":"MegaScale-MoE","offset":10333},{"match":"MegaScale-MoE","offset":10513}],"excerpt":"# MegaScale-MoE: Large-Scale Communication-Efficient Training of Mixture-of-Experts Models in Production\nChao Jin\\*§, Ziheng Jiang\\*†, Zhihao Bai<sup>†</sup>, Zheng Zhong<sup>†</sup>, Juncai Liu<sup>†</sup>, Xiang Li<sup>†</sup>, Ningxin Zheng<sup>†</sup>, Xi Wang<sup>†</sup>, Cong Xie<sup>†</sup>, Q…"},{"filename"