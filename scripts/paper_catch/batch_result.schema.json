{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "paper-catch-batch-result-v1" },
    "runId": { "type": "string", "minLength": 1 },
    "batchId": { "type": "string", "minLength": 1 },
    "batchSummary": { "type": "string", "minLength": 1 },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "layers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["ALGORITHM", "FRAMEWORK", "SYSTEM", "HARDWARE"]
            }
          },
          "priority": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "relevanceReason": { "type": "string", "minLength": 1 },
          "performanceProblem": { "type": "string", "minLength": 1 },
          "conciseContribution": { "type": "string", "minLength": 1 },
          "openSource": { "type": "string", "enum": ["YES", "NO", "UNKNOWN"] },
          "codeUrl": {
            "anyOf": [
              { "type": "string", "pattern": "^https?://" },
              { "type": "null" }
            ]
          },
          "newnessReason": { "type": "string", "minLength": 1 }
        },
        "required": [
          "candidateId",
          "layers",
          "priority",
          "relevanceReason",
          "performanceProblem",
          "conciseContribution",
          "openSource",
          "codeUrl",
          "newnessReason"
        ]
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["candidateId", "reason"]
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "batchId",
    "batchSummary",
    "selected",
    "rejected"
  ]
}
